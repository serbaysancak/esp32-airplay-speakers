# ESP-IDF build output. build-devkit/ is the N8R2 bring-up target; its generated
# sdkconfig lives inside it precisely so it can never overwrite the product one.
build/
build-devkit/
sdkconfig
sdkconfig.old
managed_components/

# dependencies.lock is NOT ignored: it pins the exact managed-component
# versions, and a build that cannot be reproduced is not a build.

# Host test build output
/test/build/
